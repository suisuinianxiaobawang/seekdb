# description: Encoded FTS build sort preserves collation equality, document mapping and DML rebuilds.
SET NAMES utf8mb4;
SET ob_query_timeout=100000000;
--disable_warnings
DROP DATABASE IF EXISTS fts_build_collations;
--enable_warnings
CREATE DATABASE fts_build_collations;
USE fts_build_collations;
CREATE TABLE docs_utf8mb4_bin_beng(id VARCHAR(30) PRIMARY KEY,body TEXT) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin;
INSERT INTO docs_utf8mb4_bin_beng VALUES('pk01','ALPHA alpha café CAFÉ 数据库全文索引'),('pk02','Alpha alpha cafe abc 北京 南京市长江大桥'),('pk03','a alpha 123 abc 中文分词'),('pk04','the AND a'),('pk05',''),('pk06',NULL);
ALTER TABLE docs_utf8mb4_bin_beng ADD FULLTEXT INDEX ft(body) WITH PARSER beng;
SELECT COUNT(*) FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('alpha');
SELECT id,ROUND(MATCH(body) AGAINST('alpha'),8) AS score FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('alpha') ORDER BY id;
SELECT COUNT(*) FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('cafe café');
SELECT id,ROUND(MATCH(body) AGAINST('cafe café'),8) AS score FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('cafe café') ORDER BY id;
SELECT COUNT(*) FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('数据库 南京');
SELECT id,ROUND(MATCH(body) AGAINST('数据库 南京'),8) AS score FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('数据库 南京') ORDER BY id;
SELECT COUNT(*) FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('中文 abc');
SELECT id,ROUND(MATCH(body) AGAINST('中文 abc'),8) AS score FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('中文 abc') ORDER BY id;
SELECT COUNT(*) FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('missingzxqv');
SELECT id,ROUND(MATCH(body) AGAINST('missingzxqv'),8) AS score FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('missingzxqv') ORDER BY id;
UPDATE docs_utf8mb4_bin_beng SET body='alpha alpha 中文 数据库' WHERE id='pk01';
INSERT INTO docs_utf8mb4_bin_beng VALUES('pk07','ALPHA cafe 中文');
DELETE FROM docs_utf8mb4_bin_beng WHERE id='pk03';
SELECT id,ROUND(MATCH(body) AGAINST('alpha cafe 中文 数据库'),8) AS score FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('alpha cafe 中文 数据库') ORDER BY id;
ALTER TABLE docs_utf8mb4_bin_beng DROP INDEX ft;
ALTER TABLE docs_utf8mb4_bin_beng ADD FULLTEXT INDEX ft(body) WITH PARSER beng;
SELECT id,ROUND(MATCH(body) AGAINST('alpha cafe 中文 数据库'),8) AS score FROM docs_utf8mb4_bin_beng WHERE MATCH(body) AGAINST('alpha cafe 中文 数据库') ORDER BY id;
DROP TABLE docs_utf8mb4_bin_beng;
