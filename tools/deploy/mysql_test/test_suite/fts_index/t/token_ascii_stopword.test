# description: Preserve English scanning, stopword collation and binary conversion.
SET NAMES utf8mb4;
SELECT TOKENIZE('ABC abc 123 foo-bar foo_bar foo@example.com C++ C#', 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') AS tokens;
SELECT TOKENIZE(CONVERT(0x000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f USING utf8mb4), 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') AS tokens;
SELECT TOKENIZE(CONCAT('alpha', CHAR(0), 'bravo', CHAR(9), 'charlie', CHAR(10), 'delta', CHAR(13), 'echo', CHAR(127), 'foxtrot'), 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE('... ,!? -- () [] {}', 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(' alpha beta ', 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE('alpha beta', 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE('数据库alpha 😀beta café résumé ＡＢＣ alpha数据库', 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE('THE thé ThE the database DATABASE café CAFE' COLLATE utf8mb4_bin, 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE('THE thé ThE the database DATABASE café CAFE' COLLATE utf8mb4_unicode_ci, 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(CONVERT('THE database' USING binary), 'beng', '[{"output":"all"}]') AS tokens;
SELECT TOKENIZE(CONVERT('THE database' USING binary), 'space', '[{"output":"all"}]') AS tokens;
