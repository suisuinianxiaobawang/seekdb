--disable_warnings
DROP DATABASE IF EXISTS fts_ascii_stopword;
--enable_warnings
CREATE DATABASE fts_ascii_stopword;
USE fts_ascii_stopword;
CREATE TABLE docs(id INT PRIMARY KEY, body TEXT COLLATE utf8mb4_bin, FULLTEXT INDEX ft(body) WITH PARSER beng);
INSERT INTO docs VALUES (1,'THE thé database café'), (2,'database PERFORMANCE'), (3,'performance audit'), (4,'...'), (5,NULL), (6,'');
SELECT id FROM docs WHERE MATCH(body) AGAINST('database performance') ORDER BY id;
SELECT id, ROUND(MATCH(body) AGAINST('database performance'), 8) AS score FROM docs ORDER BY id;
SELECT id FROM docs WHERE MATCH(body) AGAINST('THE thé') ORDER BY id;
UPDATE docs SET body='DATABASE audit' WHERE id=3;
DELETE FROM docs WHERE id=1;
SELECT id FROM docs WHERE MATCH(body) AGAINST('database performance') ORDER BY id;
DROP DATABASE fts_ascii_stopword;
