# description: Same-charset stopword views retain accent/case semantics; conversions retain their output.
SET NAMES utf8mb4;
SELECT TOKENIZE(CONVERT('THE thé ThE the WHERE whére with WÍTH alpha DATABASE café' USING utf8mb4), 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') AS tokens;
SELECT TOKENIZE(CONVERT('a an about com de en for from how i in is it la of on or that this to was what when where who will with und www' USING utf8mb4), 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') AS tokens;
SELECT TOKENIZE(CONVERT('ＡＢＣ İ ß 数据库 😀 é' USING utf8mb4), 'beng', '[{"output":"all"},{"additional_args":[{"min_token_size":1}]}]') AS tokens;
