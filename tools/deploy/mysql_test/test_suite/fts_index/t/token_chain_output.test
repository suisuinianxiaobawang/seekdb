# description: Singleton and overlapping IK chains preserve token order, type and frequency.
SET NAMES utf8mb4;
SELECT TOKENIZE('alpha beta gamma delta epsilon zeta eta theta iota kappa' COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
SELECT TOKENIZE('研究生命起源 南京市长江大桥 中华人民共和国人民大会堂' COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
SELECT TOKENIZE('一公斤一平方米两个廿世纪一世纪12小时' COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
SELECT TOKENIZE('南京市,长江大桥。alpha-beta _C++ 中华人民共和国' COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
SELECT TOKENIZE('😀𠀀漢かな한글éÉßİａｂＣ' COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
SELECT TOKENIZE(CONVERT(CONCAT('数据库',CHAR(0),'alpha 全文索引') USING utf8mb4) COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
SELECT TOKENIZE('...   ' COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
SELECT TOKENIZE(REPEAT('alpha beta 数据库全文索引 南京市长江大桥 ',70) COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS tokens;
