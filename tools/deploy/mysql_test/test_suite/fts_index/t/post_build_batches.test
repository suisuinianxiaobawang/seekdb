SELECT COUNT(*) FROM docs_ngram2 WHERE MATCH(body) AGAINST('word000 word255 word256 word511 word512 word999');
SELECT id,ROUND(MATCH(body) AGAINST('word000 word255 word256 word511 word512 word999'),8) AS score FROM docs_ngram2 WHERE MATCH(body) AGAINST('word000 word255 word256 word511 word512 word999') ORDER BY id;
