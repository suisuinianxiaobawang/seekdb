SELECT COUNT(*) FROM parts WHERE MATCH(body) AGAINST('the and of');
SELECT id,ROUND(MATCH(body) AGAINST('the and of'),8) AS score FROM parts WHERE MATCH(body) AGAINST('the and of') ORDER BY id;
SELECT COUNT(*) FROM parts WHERE MATCH(body) AGAINST('missingzxqv');
SELECT id,ROUND(MATCH(body) AGAINST('missingzxqv'),8) AS score FROM parts WHERE MATCH(body) AGAINST('missingzxqv') ORDER BY id;
