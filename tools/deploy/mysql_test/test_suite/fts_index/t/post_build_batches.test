INSERT INTO docs VALUES(13,'database word000');
UPDATE docs SET body='word999 database beta' WHERE id=2;
DELETE FROM docs WHERE id=10;
SELECT id,ROUND(MATCH(body) AGAINST('word000 word999 database'),8) AS score FROM docs WHERE MATCH(body) AGAINST('word000 word999 database') ORDER BY id;
ALTER TABLE docs DROP INDEX ft;
ALTER TABLE docs ADD FULLTEXT INDEX ft(body) WITH PARSER beng;
SELECT id,ROUND(MATCH(body) AGAINST('word000 word999 database'),8) AS score FROM docs WHERE MATCH(body) AGAINST('word000 word999 database') ORDER BY id;
CREATE TABLE empty_docs(id INT PRIMARY KEY,body TEXT);
ALTER TABLE empty_docs ADD FULLTEXT INDEX ft(body) WITH PARSER beng;
SELECT COUNT(*) FROM empty_docs WHERE MATCH(body) AGAINST('database');
CREATE TABLE stop_docs(id INT PRIMARY KEY,body TEXT);
INSERT INTO stop_docs VALUES(1,NULL),(2,''),(3,'the and of');
ALTER TABLE stop_docs ADD FULLTEXT INDEX ft(body) WITH PARSER beng;
SELECT COUNT(*) FROM stop_docs WHERE MATCH(body) AGAINST('the database');
DROP DATABASE fts_post_build_batches;
