PREPARE posting_q FROM 'SELECT COUNT(*) FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST(?) LIMIT ? OFFSET ?) s';
SET @text='alpha bravo',@lim=1,@off=0;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='alpha bravo',@lim=20,@off=255;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='alpha bravo',@lim=257,@off=511;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='missingzxqv',@lim=20,@off=0;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='echo',@lim=9999,@off=0;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='echo',@lim=20,@off=2048;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='alpha',@lim=0,@off=0;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='alpha bravo charlie delta echo foxtrot golf hotel',@lim=1,@off=0;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='alpha',@lim=9999,@off=9999;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='alpha bravo',@lim=513,@off=512;
EXECUTE posting_q USING @text,@lim,@off;
SET @text='alpha bravo',@lim=20,@off=0;
EXECUTE posting_q USING @text,@lim,@off;
DEALLOCATE PREPARE posting_q;
UPDATE docs SET body='alpha bravo' WHERE MOD(id,19)=0;
DELETE FROM docs WHERE MOD(id,23)=0;
SELECT COUNT(*) FROM docs WHERE MATCH(body) AGAINST('alpha bravo charlie');
DROP DATABASE fts_posting_batches;
