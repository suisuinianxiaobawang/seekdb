# description: Built-in IK processors preserve transition order and document-local state.
SET NAMES utf8mb4;
SET ob_query_timeout=100000000;
SELECT TOKENIZE('abc123.45公斤三百二十一米南京市长江大桥XYZ','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT TOKENIZE('１２３ａｂＣ二〇二六年十万千米，a-b+c_42@例子','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT TOKENIZE('𠀀😀漢かな한글éÉßİ中文ABC123','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT TOKENIZE('一二三十百千万亿两个人，3.14公斤，12小时abc','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT TOKENIZE('abc','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT TOKENIZE('123','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT TOKENIZE('三百公里','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT TOKENIZE('','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]');
SELECT SHA2(CAST(TOKENIZE(CONCAT(REPEAT('a ',999),'三百公斤ABC123南京市长江大桥') COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS CHAR),256);
SELECT SHA2(CAST(TOKENIZE(CONCAT(REPEAT('a ',1000),'三百公斤ABC123南京市长江大桥') COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS CHAR),256);
SELECT SHA2(CAST(TOKENIZE(CONCAT(REPEAT('a ',1001),'三百公斤ABC123南京市长江大桥') COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS CHAR),256);
SELECT SHA2(CAST(TOKENIZE(CONCAT(REPEAT('a ',2005),'三百公斤ABC123南京市长江大桥') COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"smart"}]}]') AS CHAR),256);
SELECT TOKENIZE('abc123.45公斤三百二十一米南京市长江大桥XYZ','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT TOKENIZE('１２３ａｂＣ二〇二六年十万千米，a-b+c_42@例子','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT TOKENIZE('𠀀😀漢かな한글éÉßİ中文ABC123','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT TOKENIZE('一二三十百千万亿两个人，3.14公斤，12小时abc','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT TOKENIZE('abc','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT TOKENIZE('123','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT TOKENIZE('三百公里','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT TOKENIZE('','ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]');
SELECT SHA2(CAST(TOKENIZE(CONCAT(REPEAT('a ',999),'三百公斤ABC123南京市长江大桥') COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') AS CHAR),256);
SELECT SHA2(CAST(TOKENIZE(CONCAT(REPEAT('a ',1000),'三百公斤ABC123南京市长江大桥') COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') AS CHAR),256);
SELECT SHA2(CAST(TOKENIZE(CONCAT(REPEAT('a ',1001),'三百公斤ABC123南京市长江大桥') COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') AS CHAR),256);
SELECT SHA2(CAST(TOKENIZE(CONCAT(REPEAT('a ',2005),'三百公斤ABC123南京市长江大桥') COLLATE utf8mb4_bin,'ik','[{"output":"all"},{"additional_args":[{"ik_mode":"max_word"}]}]') AS CHAR),256);
PREPARE processor_q FROM 'SELECT TOKENIZE(?,"ik",?)';
SET @text='abc123三百公里',@config='[{"additional_args":[{"ik_mode":"smart"}]}]';
EXECUTE processor_q USING @text,@config;
SET @text='南京市长江大桥',@config='[{"additional_args":[{"ik_mode":"max_word"}]}]';
EXECUTE processor_q USING @text,@config;
SET @text='三百公斤ABC123',@config='[{"additional_args":[{"ik_mode":"smart"}]}]';
EXECUTE processor_q USING @text,@config;
DEALLOCATE PREPARE processor_q;
