SELECT TOKENIZE('database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE database DATABASE ', 'beng', '[{"output":"all"}]') AS tokens;
