PREPARE processor_q FROM 'SELECT TOKENIZE(?,"ik",?)';
SET @text='abc123三百公里',@config='[{"additional_args":[{"ik_mode":"smart"}]}]';
EXECUTE processor_q USING @text,@config;
TOKENIZE(?,"ik",?)
["三百公里", "abc123"]
SET @text='南京市长江大桥',@config='[{"additional_args":[{"ik_mode":"max_word"}]}]';
EXECUTE processor_q USING @text,@config;
TOKENIZE(?,"ik",?)
["长江大桥", "市长", "南京市", "南京", "长江", "大桥"]
SET @text='三百公斤ABC123',@config='[{"additional_args":[{"ik_mode":"smart"}]}]';
EXECUTE processor_q USING @text,@config;
TOKENIZE(?,"ik",?)
["abc123", "三百公斤"]
DEALLOCATE PREPARE processor_q;
