SELECT COUNT(*),SUM(id),BIT_XOR(id) FROM docs WHERE MATCH(body) AGAINST('prefix00 prefix17 prefix79');
COUNT(*)	SUM(id)	BIT_XOR(id)
8193	33558528	8192
SELECT COUNT(*),SUM(id),BIT_XOR(id) FROM docs WHERE MATCH(body) AGAINST('数据库 全文索引');
COUNT(*)	SUM(id)	BIT_XOR(id)
8193	33558528	8192
SELECT COUNT(*) FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST('prefix00 prefix79') LIMIT 513 OFFSET 512)s;
COUNT(*)
513
CREATE TABLE parts LIKE docs;
ALTER TABLE parts DROP INDEX secondary_sort;
ALTER TABLE parts DROP INDEX ft;
ALTER TABLE parts PARTITION BY HASH(id) PARTITIONS 4;
INSERT INTO parts SELECT * FROM docs;
ALTER TABLE parts ADD INDEX secondary_sort(g,v,b,amount,stamp);
ALTER TABLE parts ADD FULLTEXT INDEX ft(body) WITH PARSER ik;
SELECT COUNT(*),SUM(id),BIT_XOR(id) FROM parts FORCE INDEX(secondary_sort) WHERE g IS NULL OR g BETWEEN 3 AND 17;
COUNT(*)	SUM(id)	BIT_XOR(id)
4571	18709285	12097
SELECT COUNT(*),SUM(id),BIT_XOR(id) FROM parts WHERE MATCH(body) AGAINST('prefix00 prefix17 prefix79');
COUNT(*)	SUM(id)	BIT_XOR(id)
8193	33558528	8192
UPDATE docs SET body='alpha charlie 全文检索' WHERE MOD(id,19)=0;
DELETE FROM docs WHERE MOD(id,23)=0;
SELECT COUNT(*),SUM(id),BIT_XOR(id) FROM docs WHERE MATCH(body) AGAINST('prefix00 charlie');
COUNT(*)	SUM(id)	BIT_XOR(id)
7836	32096970	8672
ALTER TABLE docs DROP INDEX ft;
ALTER TABLE docs ADD FULLTEXT INDEX ft(body) WITH PARSER ik;
SELECT COUNT(*),SUM(id),BIT_XOR(id) FROM docs WHERE MATCH(body) AGAINST('prefix00 charlie');
COUNT(*)	SUM(id)	BIT_XOR(id)
7836	32096970	8672
DROP DATABASE fts_compact_sort;
