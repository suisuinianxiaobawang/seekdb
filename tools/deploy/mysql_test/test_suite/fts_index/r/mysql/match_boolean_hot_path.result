SET NAMES utf8mb4;
DROP DATABASE IF EXISTS fts_match_boolean;
CREATE DATABASE fts_match_boolean;
USE fts_match_boolean;
CREATE TABLE docs(id INT PRIMARY KEY,title VARCHAR(128),body TEXT,tag INT,FULLTEXT INDEX ft(title,body) WITH PARSER ik);
INSERT INTO docs VALUES
(1,'database','performance performance audit',1),
(2,'database','database database',2),
(3,'数据库','南京市长江大桥',1),
(4,'other','unrelated text',2),
(5,NULL,'database',1),(6,'database',NULL,2),(7,NULL,NULL,1),(8,'','',2);
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('database performance') ORDER BY id;
id
1
2
5
6
SELECT COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST('database database performance');
matches
4
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('database performance') AND tag=1 ORDER BY id;
id
1
5
SELECT tag,COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST('database performance') GROUP BY tag ORDER BY tag;
tag	matches
1	2
2	2
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('database performance') ORDER BY id LIMIT 1,2;
id
2
5
SELECT COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST('');
matches
0
SELECT COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST('missingword');
matches
0
SELECT /*+opt_param('ROWSETS_MAX_ROWS',0)*/ COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST('database performance');
matches
4
SELECT /*+opt_param('ROWSETS_MAX_ROWS',1)*/ COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST('database performance');
matches
4
SELECT COUNT(IF(MATCH(title,body) AGAINST('database performance'),1,0)) AS matches FROM docs WHERE MATCH(title,body) AGAINST('database performance');
matches
4
SELECT COUNT(CASE WHEN MATCH(title,body) AGAINST('database performance') THEN 1 END) AS matches FROM docs WHERE MATCH(title,body) AGAINST('database performance');
matches
4
SELECT COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST('database performance') AND IF(MATCH(title,body) AGAINST('database performance'),1,0);
matches
4
SELECT id,ROUND(MATCH(title,body) AGAINST('database performance'),9) AS score FROM docs WHERE MATCH(title,body) AGAINST('database performance') ORDER BY id;
id	score
1	2.993553427
2	0.462184874
5	0.395683453
6	0.395683453
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('database performance')>0.5 ORDER BY id;
id
1
SELECT id,ROUND(MATCH(title,body) AGAINST('database performance'),9) AS score FROM docs WHERE MATCH(title,body) AGAINST('database performance') ORDER BY score DESC,id LIMIT 3;
id	score
1	2.993553427
2	0.462184874
5	0.395683453
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('+database +performance' IN BOOLEAN MODE) ORDER BY id;
id
1
PREPARE query FROM 'SELECT id FROM docs WHERE MATCH(title,body) AGAINST(?) ORDER BY id';
SET @q='database';
EXECUTE query USING @q;
id
1
2
5
6
SET @q='';
EXECUTE query USING @q;
id
SET @q='数据库';
EXECUTE query USING @q;
id
3
DEALLOCATE PREPARE query;
PREPARE query FROM 'SELECT COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST(?)';
SET @q='database performance';
EXECUTE query USING @q;
matches
4
SET @q='';
EXECUTE query USING @q;
matches
0
SET @q='数据库';
EXECUTE query USING @q;
matches
1
DEALLOCATE PREPARE query;
UPDATE docs SET body='database performance' WHERE id=4;
DELETE FROM docs WHERE id=2;
SELECT id FROM docs WHERE MATCH(title,body) AGAINST('database performance') ORDER BY id;
id
1
4
5
6
SELECT id,ROUND(MATCH(title,body) AGAINST('database performance'),9) AS score FROM docs WHERE MATCH(title,body) AGAINST('database performance') ORDER BY id;
id	score
1	1.911870549
4	1.689251706
5	0.395683453
6	0.395683453
TRUNCATE TABLE docs;
SELECT COUNT(*) AS matches FROM docs WHERE MATCH(title,body) AGAINST('database performance');
matches
0
DROP DATABASE fts_match_boolean;
