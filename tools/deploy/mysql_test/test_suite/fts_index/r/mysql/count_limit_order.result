PREPARE ps FROM 'SELECT COUNT(*) FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST(?) LIMIT ? OFFSET ?) s';
SET @term='alpha bravo',@lim=20,@off=0;
EXECUTE ps USING @term,@lim,@off;
COUNT(*)
20
SET @term='alpha bravo',@lim=20,@off=300;
EXECUTE ps USING @term,@lim,@off;
COUNT(*)
7
SET @term='missingzxqv',@lim=20,@off=0;
EXECUTE ps USING @term,@lim,@off;
COUNT(*)
0
SET @term='alpha bravo',@lim=0,@off=0;
EXECUTE ps USING @term,@lim,@off;
COUNT(*)
0
SET @term='alpha bravo',@lim=999,@off=0;
EXECUTE ps USING @term,@lim,@off;
COUNT(*)
307
SET @term='alpha bravo',@lim=9223372036854775807,@off=0;
EXECUTE ps USING @term,@lim,@off;
ERROR HY000: Invalid argument
SET @lim=20,@off=0;
EXECUTE ps USING @term,@lim,@off;
COUNT(*)
20
SET @lim=9223372036854775807,@off=10000;
EXECUTE ps USING @term,@lim,@off;
ERROR HY000: Invalid argument
SET @lim=1,@off=0;
EXECUTE ps USING @term,@lim,@off;
COUNT(*)
1
DEALLOCATE PREPARE ps;
DROP DATABASE fts_count_limit_order;
