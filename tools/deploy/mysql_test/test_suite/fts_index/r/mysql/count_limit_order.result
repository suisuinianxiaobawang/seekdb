SELECT COUNT(*) AS hits,COUNT(*)+1 AS next_hits FROM (SELECT g,COUNT(*) AS n FROM docs GROUP BY g ORDER BY n,g LIMIT 3) s HAVING COUNT(*)>=0;
hits	next_hits
3	4
SELECT COUNT(*) AS hits,COUNT(*)+1 AS next_hits FROM (SELECT id FROM docs WHERE id<0 ORDER BY id LIMIT 2) s HAVING COUNT(*)>=0;
hits	next_hits
0	1
