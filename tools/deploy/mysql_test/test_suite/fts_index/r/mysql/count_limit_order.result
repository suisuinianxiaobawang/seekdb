SELECT COUNT(*) AS hits,COUNT(*)+1 AS next_hits FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST('alpha bravo') ORDER BY id DESC LIMIT 20) s HAVING COUNT(*)>=0;
hits	next_hits
20	21
SELECT COUNT(*) AS hits,COUNT(*)+1 AS next_hits FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST('alpha bravo') AND g IS NOT NULL LIMIT 20) s HAVING COUNT(*)>=0;
hits	next_hits
20	21
SELECT COUNT(*) AS hits,COUNT(*)+1 AS next_hits FROM (SELECT id FROM docs ORDER BY id DESC LIMIT 20 OFFSET 300) s HAVING COUNT(*)>=0;
hits	next_hits
10	11
SELECT COUNT(*) AS hits,COUNT(*)+1 AS next_hits FROM (SELECT id FROM docs ORDER BY g,id DESC LIMIT 20 OFFSET 300) s HAVING COUNT(*)>=0;
hits	next_hits
10	11
SELECT COUNT(*) AS hits,COUNT(*)+1 AS next_hits FROM (SELECT DISTINCT g FROM docs ORDER BY g LIMIT 2) s HAVING COUNT(*)>=0;
hits	next_hits
