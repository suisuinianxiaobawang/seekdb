PREPARE q FROM 'SELECT COUNT(*) AS hits FROM (SELECT id FROM docs WHERE MATCH(body) AGAINST(?) LIMIT 20)t';
SET @q='database audit';
EXECUTE q USING @q;
hits
20
SET @q='performance';
EXECUTE q USING @q;
hits
20
SET @q='zxqvmissingword';
EXECUTE q USING @q;
