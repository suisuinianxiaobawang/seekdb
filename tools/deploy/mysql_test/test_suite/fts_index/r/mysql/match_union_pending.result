PREPARE union_q FROM 'SELECT COUNT(*),SUM(id) FROM docs WHERE MATCH(body) AGAINST(?)';
SET @q='alpha delta hotel';
EXECUTE union_q USING @q;
COUNT(*)	SUM(id)
448	118848
SET @q='missingzxqv hotel';
EXECUTE union_q USING @q;
COUNT(*)	SUM(id)
256	81792
SET @q='bravo foxtrot golf';
EXECUTE union_q USING @q;
COUNT(*)	SUM(id)
448	117600
SET @q='missingzxqv';
