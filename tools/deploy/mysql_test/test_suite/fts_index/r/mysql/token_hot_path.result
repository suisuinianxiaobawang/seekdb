DROP DATABASE IF EXISTS fts_token_hot_path;
CREATE DATABASE fts_token_hot_path;
USE fts_token_hot_path;
CREATE TABLE docs(id INT PRIMARY KEY, body TEXT, FULLTEXT INDEX ft(body) WITH PARSER ik);
INSERT INTO docs VALUES (1, '南京市长江大桥 数据库全文索引'), (2, 'OceanBase database performance'), (3, '数据库数据库 查询优化'), (4, 'ＡＢＣ１２３ 一百公斤'), (5, '长江大桥 南京市'), (6, '');
SELECT id FROM docs WHERE MATCH(body) AGAINST('数据库') ORDER BY id;
id
1
3
SELECT COUNT(*) AS matches FROM docs WHERE MATCH(body) AGAINST('数据库 南京市 长江大桥');
matches
3
